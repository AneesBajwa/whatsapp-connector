# systemd unit for the WhatsApp push listener (bin/listen.cjs), system scope.
# Prefer the user-scope unit (muse-whatsapp-listener.user.service) where the
# VM supports it: it lives in the home folder, which survives a VM
# replacement; /etc does not. deploy/install-listener.sh installs either.
#
# By hand: replace the four <...> values (node path: command -v node), then
#   sudo cp deploy/muse-whatsapp-listener.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now muse-whatsapp-listener
#   journalctl -u muse-whatsapp-listener -f
#
# Exit codes: 0 stopped by a signal, 1 error (restarted), 2 no linked session
# in auth/ (not restarted: the listener never pairs; the device must be linked
# from home with pair-qr), 3 another listener already holds the session (not
# restarted, so two supervisors never fight over it).

[Unit]
Description=Muse WhatsApp listener (Baileys connector)
After=network-online.target
Wants=network-online.target
# Never stop restarting it: a crash loop is reported by the listener itself
# (Kind: lifecycle, crash-loop), not by systemd giving up silently.
StartLimitIntervalSec=0

[Service]
Type=simple
User=<user that owns the connector folder>
WorkingDirectory=<absolute path to the connector folder>
# Node's fetch (WhatsApp version lookup) only uses the proxy with this set.
Environment=NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=... and anything else the VM needs; keep this file mode 600.
EnvironmentFile=-<absolute path to the connector folder>/listener.env
ExecStart=<absolute path to node> bin/listen.cjs
# Back after any exit that systemd did not ask for (a crash, a kill), except 2 and 3.
Restart=always
RestartSec=10
RestartPreventExitStatus=2 3
UMask=0077
# SIGTERM: the listener saves the store, pushes its stop event, closes the
# connection and releases session.lock before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
